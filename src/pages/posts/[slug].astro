---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<BlogLayout 
  title={`${post.data.title} — Ewan John Dennis`} 
  description={post.data.summary}
  type={post.data.type}
  path={`~/posts/${post.slug}.md`}
>
  <article class="post-wrapper">
    <!-- Back Navigation Bar -->
    <nav class="back-nav">
      <button id="back-btn" class="back-btn">← back</button>
      {post.data.link && (
        <a href={post.data.link} target="_blank" rel="noreferrer" class="project-link">
          repository / demo ↗
        </a>
      )}
    </nav>

    <header class="post-header">
      <div class="card-meta">
        <span class="badge">{post.data.type}</span>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString("en-US", {
            day: "2-digit",
            month: "short",
            year: "numeric",
          })}
        </time>
      </div>

      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>

      <div class="tags">
        {post.data.tags.map((tag) => (
          <span class="tag">[{tag}]</span>
        ))}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <script>
    const backBtn = document.getElementById("back-btn");
    backBtn?.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });
  </script>
</BlogLayout>

<style>
  .post-wrapper {
    width: 100%;
    max-width: 100%;
  }

  .back-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .back-btn {
    background: none;
    border: 1px solid var(--border);
    background-color: var(--card);
    color: var(--muted-2);
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .back-btn:hover {
    color: var(--foreground);
    border-color: var(--line-strong);
  }

  .project-link {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--foreground);
    background-color: var(--line);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .project-link:hover {
    border-color: var(--line-strong);
  }

  .post-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-1);
    margin-bottom: 0.75rem;
  }

  .badge {
    text-transform: uppercase;
    color: var(--foreground);
    background-color: var(--line);
    border: 1px solid var(--border);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 10px;
  }

  .post-header h1 {
    font-size: 1.85rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    line-height: 1.3;
    margin-bottom: 0.75rem;
    word-break: break-word;
  }

  .summary {
    color: var(--muted-2);
    font-size: 1rem;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted-1);
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.45rem;
    }
    .summary {
      font-size: 0.925rem;
    }
  }
</style>